# ─── DATOS (nunca commitear el dataset) ───────────────────────────────────────
data/raw/
data/processed/
data/splits/*.json       # Por defecto ignorar todos los JSON de splits
!data/splits/splits.json # ✅ Excepción: splits.json SÍ debe commitearse
!data/splits/.gitkeep

# ─── MODELOS ENTRENADOS (usar Git LFS o DVC si se requiere versionar) ──────────
experiments/**/*.keras
experiments/**/*.h5
experiments/**/*.pb
experiments/**/tensorboard/
experiments/**/*.npy        # ⚠️ Excepción: los numpy de confusión se pueden commitear
                             # Descomentar si se quieren incluir:
# !experiments/**/confusion_matrix.npy

# Sí commitear estos archivos de experimentos:
!experiments/**/metrics.json
!experiments/**/classification_report.txt
!experiments/**/model_summary.txt
!experiments/**/*_epoch_log.csv
!experiments/**/figures/*.png
!experiments/all_results.csv

# ─── REPORTES ─────────────────────────────────────────────────────────────────
# Sí commitear figures y CSVs de reportes

# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
.kaggle/
kaggle.json
*.env
.env.*

# ─── LOGS ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── MLflow ───────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/
